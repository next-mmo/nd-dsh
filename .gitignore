!/vendor/openpencil.json
!/vendor/openpencil.LICENSE

# Built ND Pencil runtime staged for packaging; never commit platform binaries.
/resources/nd-pencil/bin/

*.tsbuildinfo

# ZCode session artifacts
.zcode/

# Local scratch space for ad-hoc dev runs.
scratch/

# Todo example local runtime state (npm cache, logs, JSON data store)
examples/todo/cache/
examples/todo/data/
beta-qa-report-**
# Local performance evidence; reviewed baselines are copied intentionally.
benchmark-results/
# Isolated desktop exploration profiles, generated projects, and local evidence.
/output/real-world/

# Separate cargo target dir used by sidecar e2e runs (ND_DSH_CORE_BIN).
target-e2e/

# Chromium's generated declarative-rule index, written next to a loaded package.
resources/browser-extensions/*/_metadata/
