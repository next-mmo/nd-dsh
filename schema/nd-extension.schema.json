{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nd-dsh.local/schema/nd-extension.schema.json",
  "title": "ND extension package manifest (nd.extension/1)",
  "description": "Validated by src/shared/extension-package.ts (the runtime installer and `node scripts/validate-nd-extension.mjs` share those rules). Contributions may only reference the allowlisted ND host methods.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "id", "name", "description", "version", "apiVersion", "contexts", "contributions"],
  "properties": {
    "protocol": { "const": "nd.extension/1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
      "description": "Package-qualified identity; contribution ids must be unique inside the package."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "apiVersion": { "const": 1 },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["personal", "company", "project"] },
      "description": "Default contexts. Contributions may narrow these but never widen them."
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "notes.read",
          "notes.write",
          "capture.screen",
          "capture.area",
          "capture.read",
          "clipboard.read",
          "clipboard.write",
          "browser.navigate",
          "browser.openExternal",
          "translate.history",
          "os.launch",
          "os.wallpaper.write",
          "process.read",
          "process.quit",
          "vault.read",
          "vault.write",
          "tictactoe.read",
          "tictactoe.write",
          "minibrowser.read",
          "minibrowser.write",
          "chat.start",
          "workflow.read"
        ]
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "type"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 128 },
          "type": { "enum": ["string", "boolean", "number"] },
          "default": { "type": ["string", "boolean", "number"] },
          "description": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "executable": {
      "description": "Executable transport for tool contributions. Installation never executes it; executable trust is granted separately at activation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "args"],
      "properties": {
        "kind": { "const": "mcp-stdio" },
        "command": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "args": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 4096 } },
        "env": {
          "type": "object",
          "description": "Maps a child variable name to a parent environment-variable NAME. Secret values are never stored in manifests.",
          "additionalProperties": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
        }
      }
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "toolName"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string", "maxLength": 128 },
              "description": { "type": "string", "maxLength": 500 },
              "toolName": { "type": "string", "maxLength": 128 },
              "contexts": { "type": "array", "items": { "enum": ["personal", "company", "project"] } }
            }
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "instructions"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string", "maxLength": 128 },
              "description": { "type": "string", "maxLength": 500 },
              "instructions": { "type": "string", "maxLength": 16000 },
              "contexts": { "type": "array", "items": { "enum": ["personal", "company", "project"] } }
            }
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "host"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string", "maxLength": 128 },
              "description": { "type": "string", "maxLength": 500 },
              "keywords": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 64 } },
              "contexts": { "type": "array", "items": { "enum": ["personal", "company", "project"] } },
              "host": { "$ref": "#/$defs/hostMethod" },
              "openViewId": { "type": "string", "maxLength": 128 },
              "startsAgent": { "type": "boolean" }
            }
          }
        },
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "allOf": [
              {
                "if": { "required": ["kind"], "properties": { "kind": { "const": "web" } } },
                "then": { "required": ["entry"] },
                "else": { "required": ["host", "itemTitleKey"] }
              }
            ],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string", "maxLength": 128 },
              "description": { "type": "string", "maxLength": 500 },
              "kind": { "enum": ["list", "detail", "web"] },
              "host": { "$ref": "#/$defs/hostMethod" },
              "itemTitleKey": { "type": "string", "maxLength": 64 },
              "itemBodyKey": { "type": "string", "maxLength": 64 },
              "entry": {
                "type": "string",
                "maxLength": 256,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*\\.html$",
                "description": "Web views only: package-relative path to the UI entry HTML document."
              },
              "refreshIntervalMs": { "type": "integer", "minimum": 2000, "maximum": 60000 },
              "contexts": { "type": "array", "items": { "enum": ["personal", "company", "project"] } },
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "title", "host"],
                  "properties": {
                    "id": { "type": "string" },
                    "title": { "type": "string", "maxLength": 128 },
                    "host": { "$ref": "#/$defs/hostMethod" }
                  }
                }
              }
            }
          }
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "pluginId"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string", "maxLength": 128 },
              "description": { "type": "string", "maxLength": 500 },
              "pluginId": { "type": "string", "maxLength": 128 },
              "contexts": { "type": "array", "items": { "enum": ["personal", "company", "project"] } }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "hostMethod": {
      "enum": [
        "note.create",
        "note.search",
        "note.open",
        "note.delete",
        "capture.screen",
        "capture.area",
        "capture.list",
        "capture.copy",
        "capture.export",
        "clipboard.read",
        "clipboard.write",
        "clipboard.history.list",
        "clipboard.history.get",
        "clipboard.history.pin",
        "clipboard.history.delete",
        "clipboard.history.clear",
        "clipboard.history.copyAgain",
        "vault.list",
        "vault.get",
        "vault.create",
        "vault.update",
        "vault.delete",
        "vault.copy",
        "tictactoe.stats.get",
        "tictactoe.stats.record",
        "tictactoe.stats.reset",
        "minibrowser.session.list",
        "minibrowser.link.list",
        "minibrowser.tab.open",
        "minibrowser.tab.activate",
        "minibrowser.tab.close",
        "minibrowser.link.save",
        "minibrowser.link.remove",
        "browser.openUrl",
        "browser.translate",
        "browser.translate.history",
        "browser.translate.history.clear",
        "browser.search",
        "browser.openExternal",
        "os.openTarget",
        "os.wallpaper.chooseAndSet",
        "os.wallpaper.next",
        "os.wallpaper.previous",
        "os.wallpaper.random",
        "os.wallpaper.folders.list",
        "os.wallpaper.folders.add",
        "os.wallpaper.folders.remove",
        "os.wallpaper.playSources.set",
        "os.wallpaper.status",
        "os.wallpaper.thumbnails",
        "os.wallpaper.preview",
        "os.wallpaper.applySelected",
        "os.wallpaper.links.list",
        "os.wallpaper.links.add",
        "os.wallpaper.links.remove",
        "os.wallpaper.links.apply",
        "os.wallpaper.links.save",
        "os.wallpaper.links.next",
        "os.wallpaper.links.random",
        "os.wallpaper.collections.list",
        "os.wallpaper.collections.create",
        "os.wallpaper.collections.delete",
        "os.wallpaper.collections.add",
        "os.wallpaper.collections.removeEntry",
        "os.wallpaper.collections.apply",
        "os.wallpaper.collections.next",
        "os.wallpaper.collections.random",
        "os.wallpaper.collections.rotate",
        "os.wallpaper.collections.preview",
        "os.wallpaper.collections.thumbnails",
        "os.wallpaper.links.preview",
        "os.wallpaper.links.thumbnails",
        "os.wallpaper.links.import",
        "os.wallpaper.links.export",
        "os.wallpaper.bundle.add",
        "os.wallpaper.bundle.update",
        "os.wallpaper.bundle.remove",
        "process.list",
        "process.quit",
        "process.forceQuit",
        "chat.ask",
        "workflow.list",
        "workflow.refresh"
      ]
    }
  }
}
