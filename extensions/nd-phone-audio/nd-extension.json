{
  "protocol": "nd.extension/1",
  "id": "nd.phone-audio",
  "name": "Phone Link",
  "description": "One QR code turns your Android or iPhone into a wireless keyboard (English / Khmer typing and voice dictation) and a low-latency speaker for Windows playback audio, over local Wi-Fi or USB tethering. No APK, App Store install, or cloud server required.",
  "version": "1.3.0",
  "apiVersion": 1,
  "contexts": [
    "personal"
  ],
  "permissions": [
    "phoneaudio.read",
    "phoneaudio.write",
    "phoneinput.read",
    "phoneinput.write",
    "clipboard.write"
  ],
  "category": "system",
  "settings": [],
  "contributions": {
    "tools": [],
    "skills": [],
    "commands": [
      {
        "id": "open-phone-audio",
        "title": "Phone Link",
        "description": "Use your phone as a wireless keyboard and speaker over Wi-Fi or USB tethering — one QR pairs both.",
        "keywords": [
          "phone link",
          "phone audio",
          "phone keyboard",
          "audio",
          "keyboard",
          "speaker",
          "android",
          "iphone",
          "stream",
          "webrtc",
          "usb",
          "wifi",
          "loopback",
          "khmer"
        ],
        "host": "phoneaudio.status.get",
        "openViewId": "main",
        "contexts": [
          "personal"
        ]
      },
      {
        "id": "stop-phone-audio",
        "title": "Stop Phone Link",
        "description": "Stop the phone keyboard and audio stream and close the local pairing server.",
        "keywords": [
          "stop phone link",
          "stop phone audio",
          "stop phone keyboard",
          "stop audio stream",
          "disconnect phone"
        ],
        "host": "phoneaudio.session.stop",
        "contexts": [
          "personal"
        ]
      }
    ],
    "views": [
      {
        "id": "main",
        "title": "Phone Link",
        "description": "Phone keyboard and system-audio receiver tabs with one shared pairing QR.",
        "kind": "web",
        "entry": "ui/index.html",
        "contexts": [
          "personal"
        ],
        "actions": [
          {
            "id": "status",
            "title": "Read Phone Link audio streaming status",
            "host": "phoneaudio.status.get"
          },
          {
            "id": "start",
            "title": "Start Phone Link (keyboard + audio)",
            "host": "phoneaudio.session.start"
          },
          {
            "id": "stop",
            "title": "Stop Phone Link",
            "host": "phoneaudio.session.stop"
          },
          {
            "id": "disconnect",
            "title": "Disconnect the active phone audio receiver",
            "host": "phoneaudio.client.disconnect"
          },
          {
            "id": "rotate-token",
            "title": "Generate a new pairing code and QR token",
            "host": "phoneaudio.token.rotate"
          },
          {
            "id": "set-options",
            "title": "Update capture mode or network interface",
            "host": "phoneaudio.options.set"
          },
          {
            "id": "copy-url",
            "title": "Copy the connection URL to the clipboard",
            "host": "clipboard.write"
          },
          {
            "id": "kb-status",
            "title": "Read Phone Link keyboard status",
            "host": "phoneinput.status.get"
          },
          {
            "id": "kb-disconnect",
            "title": "Disconnect the active phone keyboard",
            "host": "phoneinput.client.disconnect"
          }
        ]
      }
    ],
    "workflows": []
  }
}